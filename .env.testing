APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:vaSVo9D3gnYPwA9rNim1eBRvpK5dAto7eVvb8jXQoEw=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=log

# Webhook Configuration
WEBHOOK_REFRESH_TIMER=30
WEBHOOK_SECRET=

# External API Configuration (placeholder values so Http::fake() mocks are
# actually exercised instead of the services short-circuiting on a blank key)
TVDB_API_KEY=test-tvdb-key
TVDB_API_URL=https://api4.thetvdb.com/v4
IMDB_API_KEY=test-tmdb-key
IMDB_API_URL=https://api.themoviedb.org/3

SHOW_RAW_WEBHOOK_DATA=true
SHOW_FILE_LOCATION=true
SHOW_WEBHOOK_EVENT_DETAILS=true
SHOW_PREMIERE_DATE=true
SHOW_PROVIDER_IDS=true

# No Emby server in the test environment; image fetching falls back to TVDB/TMDB.
EMBY_BASE_URL=
EMBY_API_KEY=

WEBHOOKS_PAGINATION_PER_PAGE=12
NEW_CARD_MINUTES=30
WEBHOOK_MAX_ENTRIES=100
IMAGE_CACHE_TTL_MINUTES=1440

WEBHOOK_ALLOWED_ITEM_TYPES="Movie,Episode,Audio"
