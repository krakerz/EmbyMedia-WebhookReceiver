APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:GENERATE_NEW_KEY_HERE
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Webhook Configuration
WEBHOOK_REFRESH_TIMER=30
WEBHOOK_SECRET=

# External API Configuration
# Get TVDB API key from https://thetvdb.com/api-information
TVDB_API_KEY=your_tvdb_api_key_here
TVDB_API_URL=https://api4.thetvdb.com/v4

# Get TMDB API key from https://www.themoviedb.org/settings/api
IMDB_API_KEY=your_tmdb_api_key_here
IMDB_API_URL=https://api.themoviedb.org/3

# Raw webhook data display configuration
SHOW_RAW_WEBHOOK_DATA=true

# Webhook details display configuration
SHOW_FILE_LOCATION=true
SHOW_WEBHOOK_EVENT_DETAILS=true

# Emby server configuration for cover images
EMBY_BASE_URL=http://your-emby-server:8096
EMBY_API_KEY=your_emby_api_key_here

# Basic display configuration
SHOW_PREMIERE_DATE=true
# Show or hide Provider IDs section in media details (true/false)
SHOW_PROVIDER_IDS=true

# Pagination configuration
WEBHOOKS_PAGINATION_PER_PAGE=12
NEW_CARD_MINUTES=30

# Cleanup configuration
# Maximum number of webhook entries to retain. On each dashboard refresh,
# entries beyond this limit (oldest first) and entries whose cover image
# could not be fetched are removed. Set to 0 to disable the entry limit.
WEBHOOK_MAX_ENTRIES=100

# Proactive broken-image sweep. No cron needed: a small batch of entries is
# re-checked on every dashboard load (including the auto-refresh reload).
# - BATCH: how many poster/backdrop URLs to re-check per page load
# - RECHECK_MINUTES: don't re-check the same entry more often than this
# - STRIKES: consecutive failed checks (spaced RECHECK_MINUTES apart) before
#   an entry is deleted — avoids nuking everything during a brief outage of
#   your Emby/TVDB/TMDB image source
WEBHOOK_IMAGE_CHECK_BATCH=5
WEBHOOK_IMAGE_RECHECK_MINUTES=15
WEBHOOK_IMAGE_CHECK_STRIKES=3

# How long (in minutes) resolved cover image lookups (TVDB/TMDB) are cached
# for, keyed by provider ID. Uses whatever CACHE_STORE is configured.
IMAGE_CACHE_TTL_MINUTES=1440

# Item Type Filtering Configuration
# Comma-separated list of item types to show and filter
# Available types: Movie, Episode, Audio, Video, etc.
# Leave empty to show all types
WEBHOOK_ALLOWED_ITEM_TYPES="Movie,Episode,Audio"